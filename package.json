{
  "name": "window-installer-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,client,admin -c red,cyan,magenta \"npm run dev:api\" \"npm run dev:client\" \"npm run dev:admin\"",
    "dev:client": "vite --config client/vite.config.js",
    "dev:admin": "vite --config admin/vite.config.js",
    "dev:api": "node server/index.js",
    "build": "npm run build:client && npm run build:admin",
    "build:client": "vite build --config client/vite.config.js",
    "build:admin": "vite build --config admin/vite.config.js",
    "preview:client": "vite preview --config client/vite.config.js",
    "preview:admin": "vite preview --config admin/vite.config.js",
    "start:api": "node server/index.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "qrcode": "^1.5.4",
    "vite": "^6.0.3"
  }
}
