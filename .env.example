# Copy to .env and set a strong secret for production.
ADMIN_KEY=change-me-to-a-long-random-secret
# Some hosts use this name — the server accepts it as an alias for ADMIN_KEY.
# ADMIN_API_KEY=

# API port (default 3001). The Node server uses PORT or API_PORT; client & admin Vite proxies use API_PORT or PORT — keep them the same and restart Vite after changes.
# PORT=3001
# API_PORT=3001

# Optional: absolute API origin for the admin app when /api proxy fails (same host:port as the API).
# Example: VITE_API_BASE=http://127.0.0.1:3020

# Admin Vite dev port (default 5174). Client dev server proxies /admin here — keep in sync if you change it.
# ADMIN_DEV_PORT=5174

# --- Payments (Stripe: Elements + Checkout) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...   (alias: STRIPE_PUBLIC_KEY)
# STRIPE_WEBHOOK_SECRET=whsec_...
# Public URL of the client site (success/cancel redirects). Dev default: http://localhost:5173
# APP_BASE_URL=http://localhost:5173

# Record test payments without Stripe (local only; do not use in production).
# ALLOW_DEMO_PAYMENTS=false

# 64-char hex (32 bytes) or any passphrase; used to encrypt payout bank fields in payout-settings.enc.json
# PAYOUT_ENCRYPTION_KEY=

# Optional: POST JSON { event, message } when a public contact form is submitted (Zapier, Slack webhook, etc.).
# CONTACT_NOTIFY_WEBHOOK=

# --- Supabase (optional, preferred persistence backend) ---
# If these are set, invoices/payments/contact messages/quote requests are stored in Supabase.
# Run server/supabase-schema.sql in your Supabase SQL editor first.
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key
# Comma-separated admin emails allowed to use /api/admin/* (recommended for production).
# Role metadata checks are also accepted (app_metadata/user_metadata role=admin|owner|super_admin, roles[], is_admin).
# SUPABASE_ADMIN_EMAILS=admin1@yourcompany.com,admin2@yourcompany.com

# Admin app login (browser) uses Supabase Auth email/password.
# These must be present in the Vite environment for admin/.
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
