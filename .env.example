# Copy to .env and set a strong secret for production.
ADMIN_KEY=change-me-to-a-long-random-secret

# API port (default 3001). Must match Vite proxy targets in client/ and admin/.
# API_PORT=3001

# Admin Vite dev port (default 5174). Client dev server proxies /admin here — keep in sync if you change it.
# ADMIN_DEV_PORT=5174
